# ============================================
# Agentic Lab — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash

# --- OpenRouter (unified gateway) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# --- Loop Defaults ---
DEFAULT_PROVIDER=ollama
DEFAULT_MAX_ITERATIONS=10
DEFAULT_DELAY_MS=1000
DEFAULT_LOG_LEVEL=info

# --- Storage Backend ---
# Options: 'postgres', 'memory' (auto-detects if not set)
# STORAGE_BACKEND=postgres

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_lab
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_lab_secret
# Or use a connection string:
# DATABASE_URL=postgresql://agentic:agentic_lab_secret@localhost:5432/agentic_lab

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Or use a URL:
# REDIS_URL=redis://localhost:6379/0

# --- Qdrant (Vector Store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=

# --- Embeddings (for semantic memory) ---
# ollama (local) or openai (uses OPENAI_API_KEY). The vector size follows the
# model; set EMBEDDING_DIMENSION only for a model the lab does not know.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=
# QDRANT_COLLECTION=agentic_lab_memories

# --- Grafana ---
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=agentic_lab

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Web Dashboard ---
NEXT_PUBLIC_API_PORT=3100
WEB_PORT=3000
