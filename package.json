{
  "name": "agentic-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Lab — Extensible platform for experimenting with agentic loops, multiple LLM providers, and autonomous AI workflows",
  "author": "David Estevez",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "./setup.sh --dev",
    "setup:full": "./setup.sh --full",
    "setup:minimal": "./setup.sh --minimal",
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w packages/core",
    "build:cli": "npm run build -w packages/cli",
    "build:web": "npm run build -w packages/web",
    "dev:web": "npm run dev -w packages/web",
    "dev:web:port": "npm run dev -w packages/web -- --port",
    "infra:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "infra:up:full": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps",
    "health": "curl -s http://localhost:3000/api/health | python3 -m json.tool",
    "cli": "npm run start -w packages/cli --",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
