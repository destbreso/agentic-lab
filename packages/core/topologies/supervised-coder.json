{
  "component_type": "Flow",
  "id": "supervised-coder",
  "name": "Supervised Coder",
  "description": "Three-loop coding pipeline with cognitive role separation: Planner decides what to build, Coder implements, Reviewer independently verifies. Mirrors a real dev team (tech lead → developer → code reviewer).",
  "metadata": {
    "agentic_lab": {
      "profile": "agentic-lab/topology@1",
      "version": "1.0.0",
      "author": "Agentic Lab",
      "category": "intermediate",
      "tags": [
        "coding",
        "supervised",
        "verification",
        "team-simulation"
      ],
      "created_at": "2025-01-01T00:00:00Z",
      "updated_at": "2025-01-01T00:00:00Z",
      "order": [
        "planner",
        "coder",
        "reviewer"
      ],
      "roles": {
        "planner": {
          "engine": "planning",
          "category": "planning",
          "face": {
            "label": "Plan",
            "icon": "☰",
            "sentence": "Plan, the tech lead, picks the next task from your task and PLAN.md and breaks it into steps for Do."
          },
          "config": {
            "toolPolicy": {
              "allow": [
                "file_read",
                "glob",
                "grep"
              ],
              "deny": [
                "file_write",
                "shell",
                "git"
              ]
            },
            "maxIterations": 1,
            "delayMs": 0,
            "concurrent": false,
            "frequency": {
              "everyNIterations": 3
            }
          },
          "ports": {
            "inputs": [
              {
                "name": "review_feedback",
                "signals": [
                  "evaluation",
                  "corrections"
                ],
                "description": "Review verdict and corrections from the Reviewer",
                "required": false
              },
              {
                "name": "execution_result",
                "signals": [
                  "execution_result"
                ],
                "description": "What the Coder actually did",
                "required": false
              }
            ],
            "outputs": [
              {
                "name": "task",
                "signals": [
                  "task"
                ],
                "description": "Selected task with decomposed steps for the Coder"
              },
              {
                "name": "plan_update",
                "signals": [
                  "plan"
                ],
                "description": "Updated plan state"
              }
            ]
          }
        },
        "coder": {
          "engine": "execution",
          "category": "execution",
          "face": {
            "label": "Do",
            "icon": ">",
            "sentence": "Do, the developer, implements the task with its tools and reports what it did, not whether it is good."
          },
          "config": {
            "maxIterations": 15,
            "delayMs": 500,
            "concurrent": false
          },
          "ports": {
            "inputs": [
              {
                "name": "task",
                "signals": [
                  "task",
                  "plan",
                  "corrections"
                ],
                "description": "Task from Planner or corrections from Reviewer",
                "required": false
              },
              {
                "name": "context",
                "signals": [
                  "context",
                  "memory"
                ],
                "description": "Context, and an operator's note mid-run",
                "required": false
              }
            ],
            "outputs": [
              {
                "name": "result",
                "signals": [
                  "execution_result"
                ],
                "description": "What was implemented and claimed outcome"
              },
              {
                "name": "tool_calls",
                "signals": [
                  "tool_calls"
                ],
                "description": "All tool calls made during coding"
              },
              {
                "name": "tokens",
                "signals": [
                  "token_usage"
                ],
                "description": "Token usage report"
              }
            ]
          }
        },
        "reviewer": {
          "engine": "evaluation",
          "category": "evaluation",
          "face": {
            "label": "Check",
            "icon": "⊢",
            "sentence": "Check, the reviewer, verifies the change against the task without trusting Do's account."
          },
          "config": {
            "toolPolicy": {
              "allow": [
                "file_read",
                "glob",
                "grep"
              ],
              "deny": [
                "file_write",
                "shell",
                "git"
              ]
            },
            "maxIterations": 1,
            "delayMs": 0,
            "concurrent": false
          },
          "ports": {
            "inputs": [
              {
                "name": "execution_result",
                "signals": [
                  "execution_result"
                ],
                "description": "What the Coder claims to have done"
              },
              {
                "name": "original_task",
                "signals": [
                  "task"
                ],
                "description": "Original task from Planner (ground truth for expectations)",
                "required": false
              }
            ],
            "outputs": [
              {
                "name": "verdict",
                "signals": [
                  "evaluation"
                ],
                "description": "Pass/fail verdict with evidence from actual test runs"
              },
              {
                "name": "corrections",
                "signals": [
                  "corrections"
                ],
                "description": "Specific corrections if review fails (goes to Coder + Planner)"
              },
              {
                "name": "metrics",
                "signals": [
                  "eval_metrics"
                ],
                "description": "Review metrics (tests passed, coverage, etc.)"
              }
            ]
          }
        }
      },
      "wires": {
        "w-plan-to-code": {},
        "w-code-to-review": {},
        "w-plan-to-review": {},
        "w-review-to-code": {},
        "w-review-to-plan": {
          "fields": [
            "verdict",
            "verdictSource",
            "parsed",
            "iteration"
          ]
        },
        "w-code-to-plan": {
          "fields": [
            "iteration",
            "toolCallCount",
            "truncated"
          ]
        }
      },
      "provenance": {
        "corrections": {
          "corrections": "measured or written",
          "failedChecks": {
            "name": "given",
            "kind": "given",
            "passed": "measured",
            "exitCode": "measured",
            "output": "measured",
            "durationMs": "measured"
          },
          "verdict": "measured or written",
          "failedCriteria": "measured or written",
          "round": "measured",
          "iteration": "measured"
        },
        "eval_metrics": {
          "verdict": "measured or written",
          "verdictSource": "measured",
          "parsed": "measured",
          "checksTotal": "measured",
          "checksPassed": "measured",
          "confidence": "written",
          "iteration": "measured"
        },
        "evaluation": {
          "verdict": "measured or written",
          "verdictSource": "measured",
          "modelVerdict": "written",
          "modelError": "measured",
          "parsed": "measured",
          "evidence": "written",
          "measuredChecks": {
            "name": "given",
            "kind": "given",
            "passed": "measured",
            "exitCode": "measured",
            "output": "measured",
            "durationMs": "measured"
          },
          "automatedChecks": {
            "name": "given",
            "passed": "measured",
            "output": "measured"
          },
          "iteration": "measured"
        },
        "execution_result": {
          "responseText": "written",
          "iteration": "measured",
          "toolCallCount": "measured",
          "truncated": "measured"
        },
        "plan": {
          "plan": "written",
          "iteration": "measured"
        },
        "task": {
          "task": "written",
          "priority": "written",
          "iteration": "measured"
        },
        "token_usage": {
          "inputTokens": "measured",
          "outputTokens": "measured",
          "totalTokens": "measured",
          "iteration": "measured"
        },
        "tool_calls": {
          "calls": {
            "name": "measured",
            "arguments": "written",
            "result": "measured",
            "durationMs": "measured"
          },
          "iteration": "measured"
        }
      },
      "ways_back": [
        {
          "id": "back-to-planner",
          "from": "reviewer",
          "to": "planner",
          "label": "not passing: back to Plan",
          "when": "the review does not pass, and Plan starts the next round with the verdict",
          "wires": [
            "w-review-to-plan"
          ]
        }
      ],
      "also": [
        {
          "id": "also-corrections",
          "from": "reviewer",
          "to": "coder",
          "label": "also: corrections to Do",
          "wires": [
            "w-review-to-code"
          ]
        },
        {
          "id": "also-counts",
          "from": "coder",
          "to": "planner",
          "label": "also: Do's counts to Plan",
          "wires": [
            "w-code-to-plan"
          ]
        }
      ],
      "consults": [],
      "exit": {
        "label": "done",
        "when": [
          "the review passes,",
          "or round 5"
        ]
      },
      "limits": {
        "rounds": 5,
        "delay_ms": 800
      },
      "parameters": [
        {
          "name": "provider",
          "description": "LLM provider for all loops",
          "type": "string",
          "required": true
        },
        {
          "name": "tools",
          "description": "Tool registry for the Coder and Reviewer",
          "type": "string",
          "required": true
        },
        {
          "name": "workingDir",
          "description": "Working directory for the coding project",
          "type": "string",
          "required": true
        },
        {
          "name": "promptFile",
          "description": "Path to the prompt / instructions file",
          "type": "string",
          "required": false,
          "default": "PROMPT.md"
        },
        {
          "name": "planFile",
          "description": "Path to the implementation plan file",
          "type": "string",
          "required": false,
          "default": "PLAN.md"
        },
        {
          "name": "specsDir",
          "description": "Directory containing project specifications",
          "type": "string",
          "required": false,
          "default": "specs"
        }
      ]
    }
  },
  "inputs": [
    {
      "title": "task",
      "type": "string",
      "description": "The task as you give it"
    },
    {
      "title": "run_inputs",
      "type": "string",
      "description": "The run's other inputs: the conversation, recalled memories",
      "default": ""
    }
  ],
  "outputs": [
    {
      "title": "answer",
      "type": "string",
      "description": "What Do wrote in its last turn",
      "default": ""
    }
  ],
  "start_node": {
