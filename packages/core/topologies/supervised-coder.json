        {
          "title": "corrections",
          "type": "string",
          "description": "Specific corrections if review fails (goes to Coder + Planner)",
          "default": ""
        },
        {
          "title": "metrics",
          "type": "string",
          "description": "Review metrics (tests passed, coverage, etc.)",
          "default": ""
        },
        {
          "title": "way",
          "type": "string",
          "description": "Where the work goes back to: planner; empty when it is done",
          "default": ""
        }
