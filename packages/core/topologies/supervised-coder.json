      "model_id": "chosen-at-run"
    },
    "planner": {
      "component_type": "AgentNode",
      "id": "planner",
      "name": "Tech Lead",
      "description": "Reads specs and PLAN.md, selects the single highest-priority task, decomposes it into actionable steps for the Coder",
      "inputs": [
        {
          "title": "run_task",
          "type": "string",
          "description": "Your task"
        },
        {
          "title": "run_inputs",
          "type": "string",
          "description": "The run's other inputs",
          "default": ""
        },
        {
          "title": "review_feedback",
          "type": "string",
          "description": "Review verdict and corrections from the Reviewer",
          "default": ""
        },
        {
          "title": "execution_result",
          "type": "string",
          "description": "What the Coder actually did",
          "default": ""
        }
      ],
      "outputs": [
        {
          "title": "task",
          "type": "string",
          "description": "Selected task with decomposed steps for the Coder",
          "default": ""
        },
        {
          "title": "plan_update",
          "type": "string",
          "description": "Updated plan state",
          "default": ""
        }
      ],
      "branches": [
        "next"
      ],
      "agent": {
        "component_type": "Agent",
        "id": "planner.agent",
        "name": "Plan",
        "inputs": [
          {
            "title": "run_task",
            "type": "string",
            "description": "Your task"
          },
          {
            "title": "run_inputs",
            "type": "string",
            "description": "The run's other inputs",
            "default": ""
          },
          {
            "title": "review_feedback",
            "type": "string",
            "description": "Review verdict and corrections from the Reviewer",
            "default": ""
          },
          {
            "title": "execution_result",
            "type": "string",
            "description": "What the Coder actually did",
            "default": ""
          }
        ],
        "outputs": [
          {
            "title": "task",
            "type": "string",
            "description": "Selected task with decomposed steps for the Coder",
            "default": ""
          },
          {
            "title": "plan_update",
            "type": "string",
            "description": "Updated plan state",
            "default": ""
          }
        ],
        "llm_config": {
          "$component_ref": "model.run"
        },
        "system_prompt": "Plan, the tech lead, picks the next task from your task and PLAN.md and breaks it into steps for Do.\n\nYour task: {{run_task}}\nThe run's other inputs: {{run_inputs}}\nReview verdict and corrections from the Reviewer: {{review_feedback}}\nWhat the Coder actually did: {{execution_result}}",
        "tools": [
          {
            "$component_ref": "tool.file_read"
          },
          {
            "$component_ref": "tool.glob"
          },
          {
            "$component_ref": "tool.grep"
          }
        ],
        "human_in_the_loop": false
      }
    },
    "coder": {
      "component_type": "AgentNode",
      "id": "coder",
      "name": "Developer",
      "description": "Implements the selected task: writes code, runs tests, commits. Reports what was done, NOT whether it was done well (that is the Reviewer's job)",
      "inputs": [
        {
          "title": "run_task",
          "type": "string",
          "description": "Your task"
        },
        {
          "title": "run_inputs",
          "type": "string",
          "description": "The run's other inputs",
          "default": ""
        },
        {
          "title": "task",
          "type": "string",
          "description": "Task from Planner or corrections from Reviewer",
          "default": ""
        },
        {
          "title": "context",
          "type": "string",
          "description": "Context, and an operator's note mid-run",
          "default": ""
        }
      ],
      "outputs": [
        {
          "title": "result",
          "type": "string",
          "description": "What was implemented and claimed outcome",
          "default": ""
        },
        {
          "title": "tool_calls",
          "type": "string",
          "description": "All tool calls made during coding",
          "default": ""
        },
        {
          "title": "tokens",
          "type": "string",
          "description": "Token usage report",
          "default": ""
        }
      ],
      "branches": [
        "next"
      ],
      "agent": {
        "component_type": "Agent",
        "id": "coder.agent",
        "name": "Do",
        "inputs": [
          {
            "title": "run_task",
            "type": "string",
            "description": "Your task"
          },
          {
            "title": "run_inputs",
            "type": "string",
            "description": "The run's other inputs",
            "default": ""
          },
          {
            "title": "task",
