      "id": "cf.reviewer.way.default",
      "name": "reviewer.way to end (default)",
      "from_node": {
        "$component_ref": "reviewer.way"
      },
      "from_branch": "default",
      "to_node": {
        "$component_ref": "end"
      }
    }
  ],
  "data_flow_connections": [
