{
  "component_type": "Flow",
  "id": "exec-eval",
  "name": "Execute & Evaluate",
  "description": "Two-loop pattern: Execution does work, Evaluation verifies real-world changes. Simple but effective.",
  "metadata": {
    "jig": {
      "profile": "jig/topology@1",
      "version": "1.0.0",
      "author": "Jig",
      "category": "intermediate",
      "tags": [
        "intermediate",
        "verification"
      ],
      "created_at": "2025-01-01T00:00:00Z",
      "updated_at": "2025-01-01T00:00:00Z",
      "order": [
        "exec",
        "eval"
      ],
      "roles": {
        "exec": {
          "engine": "execution",
          "category": "execution",
          "face": {
            "label": "Do",
            "icon": ">",
            "sentence": "Do does the task with its tools; after a failed check it reads the corrections and its previous answer."
          },
          "config": {
            "maxIterations": 20,
            "delayMs": 500,
            "concurrent": false
          },
          "ports": {
            "inputs": [
              {
                "name": "task",
                "signals": [
                  "task",
                  "plan",
                  "corrections"
                ],
                "description": "Task or corrections",
                "required": false
              },
              {
                "name": "context",
                "signals": [
                  "context",
                  "memory"
                ],
                "description": "Context",
                "required": false
              }
            ],
            "outputs": [
              {
                "name": "result",
                "signals": [
                  "execution_result"
                ],
                "description": "Result"
              },
              {
                "name": "tool_calls",
                "signals": [
                  "tool_calls"
                ],
                "description": "Tools"
              },
              {
                "name": "tokens",
                "signals": [
                  "token_usage"
                ],
                "description": "Tokens"
              }
            ]
          }
        },
        "eval": {
          "engine": "evaluation",
          "category": "evaluation",
          "face": {
            "label": "Check",
            "icon": "⊢",
            "sentence": "Check verifies Do's work and, when it does not pass, sends corrections back to Do."
          },
          "config": {
            "maxIterations": 1,
            "delayMs": 0,
            "concurrent": false,
            "toolPolicy": {
              "allow": [
                "file_read",
                "glob",
                "grep"
              ],
              "deny": [
                "file_write",
                "shell",
                "git"
              ]
            }
          },
          "ports": {
            "inputs": [
              {
                "name": "execution_result",
                "signals": [
                  "execution_result"
                ],
                "description": "Claimed output"
              },
              {
                "name": "ground_truth",
                "signals": [
                  "ground_truth"
                ],
                "description": "Truth",
                "required": false
              }
            ],
            "outputs": [
              {
                "name": "evaluation",
                "signals": [
                  "evaluation"
                ],
                "description": "Verdict"
              },
              {
                "name": "corrections",
                "signals": [
                  "corrections"
                ],
                "description": "Corrections"
              },
              {
                "name": "metrics",
                "signals": [
                  "eval_metrics"
                ],
                "description": "Metrics"
              }
            ]
          }
        }
      },
      "wires": {
        "w1": {},
        "w2": {}
      },
      "provenance": {
        "corrections": {
          "corrections": "measured or written",
          "failedChecks": {
            "name": "given",
            "kind": "given",
            "passed": "measured",
