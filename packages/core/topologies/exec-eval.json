          "verdictSource": "measured",
          "modelVerdict": "written",
          "modelError": "measured",
          "parsed": "measured",
          "evidence": "written",
          "measuredChecks": {
            "name": "given",
            "kind": "given",
            "passed": "measured",
            "exitCode": "measured",
            "output": "measured",
            "durationMs": "measured"
          },
          "automatedChecks": {
            "name": "given",
            "passed": "measured",
            "output": "measured"
          },
          "iteration": "measured"
        },
        "execution_result": {
          "responseText": "written",
          "iteration": "measured",
          "toolCallCount": "measured",
          "truncated": "measured"
        },
        "token_usage": {
          "inputTokens": "measured",
          "outputTokens": "measured",
          "totalTokens": "measured",
          "iteration": "measured"
        },
        "tool_calls": {
          "calls": {
            "name": "measured",
            "arguments": "written",
            "result": "measured",
            "durationMs": "measured"
          },
          "iteration": "measured"
        }
      },
      "ways_back": [
        {
          "id": "back-to-exec",
          "from": "eval",
          "to": "exec",
          "label": "check fails: back to Do",
          "when": "Check's verdict is not a pass, and its corrections go back to Do",
          "wires": [
            "w2"
          ]
        }
      ],
      "also": [],
      "consults": [],
      "exit": {
        "label": "done",
        "when": [
          "Check passes,",
          "or round 5"
        ]
      },
      "limits": {
        "rounds": 5,
        "delay_ms": 500
      },
      "parameters": [
        {
          "name": "provider",
          "description": "LLM provider",
          "type": "string",
          "required": true
        },
        {
          "name": "tools",
          "description": "Tool registry",
          "type": "string",
          "required": true
        },
        {
          "name": "workingDir",
          "description": "Working directory",
          "type": "string",
          "required": true
        }
      ]
    }
  },
  "outputs": [
    {
