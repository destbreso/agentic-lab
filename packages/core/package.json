{
  "name": "jig-core",
  "version": "0.1.4",
  "description": "The engine of Jig, a Joint Inference Graph: run a topology of models (roles, ways back, consults) on a task through one session, with measured checks, recorded steps, topology files in Agent Spec with Jig's extension, and the character grid that draws a run.",
  "keywords": [
    "llm",
    "agents",
    "multi-agent",
    "agentic",
    "topology",
    "agent-spec",
    "ollama",
    "anthropic",
    "openai",
    "harness",
    "jig"
  ],
  "author": "David Estevez",
  "license": "MIT",
  "homepage": "https://github.com/destbreso/jig/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/destbreso/jig.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/destbreso/jig/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "topologies",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "topologies": "tsc && node scripts/topologies.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "ajv": "^8.20.0",
    "dotenv": "^16.4.7",
    "eventemitter3": "^5.0.1",
    "get-east-asian-width": "^1.7.0",
    "nanoid": "^5.0.9",
    "ollama": "^0.5.12",
    "openai": "^4.73.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "pg": "^8.18.0",
    "redis": "^5.10.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "pg": "^8.18.0",
    "redis": "^5.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
