{
  "name": "jig-console",
  "version": "0.1.5",
  "description": "jig, the terminal for Jig: an interactive session where each message is a task your topology of models runs, drawn live on its grid; and run, show, replay, validate and convert for scripts.",
  "keywords": [
    "llm",
    "agents",
    "multi-agent",
    "cli",
    "terminal",
    "tui",
    "ink",
    "topology",
    "ollama",
    "harness",
    "jig"
  ],
  "author": "David Estevez",
  "license": "MIT",
  "homepage": "https://github.com/destbreso/jig/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/destbreso/jig.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/destbreso/jig/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jig": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "dotenv": "^16.4.7",
    "eventemitter3": "^5.0.1",
    "ink": "^6.8.0",
    "inquirer": "^12.3.0",
    "jig-core": "^0.1.5",
    "marked": "^18.1.3",
    "nanoid": "^5.0.9",
    "ora": "^8.1.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "get-east-asian-width": "^1.7.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
